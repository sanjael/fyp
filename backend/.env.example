# ==========================================
# RAGGuard-TR Environment Configuration
# ==========================================

# Database
POSTGRES_USER=ragguard_admin
POSTGRES_PASSWORD=ragguard_secure_password
POSTGRES_DB=ragguard_tr
DATABASE_URL=postgresql+asyncpg://ragguard_admin:ragguard_secure_password@postgres:5432/ragguard_tr

# Redis
REDIS_URL=redis://redis:6379/0

# Services
OLLAMA_HOST=http://localhost:11434
CHROMA_HOST=localhost
CHROMA_PORT=8000
USE_CHROMA_HTTP=false
ENABLE_CHROMA_TELEMETRY=false
API_URL=http://localhost:8080/health

# LLM Models
GENERATOR_LLM_MODEL=qwen2.5:latest
EMBEDDING_MODEL=nomic-embed-text

# Evaluator LLM (RAGAS & DeepEval)
EVALUATOR_PROVIDER=groq
EVALUATOR_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
