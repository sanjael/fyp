# RAGShield Environment Variables
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# App Settings
APP_NAME=RAGShield
APP_VERSION=1.0.0
DEBUG=true

# Vector DB Path
VECTOR_DB_PATH=./vector_db

# Data Paths
PDF_UPLOAD_PATH=./data/pdfs
POISONED_DATA_PATH=./data/poisoned

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM Settings
LLM_MODEL=gemini-1.5-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# Retrieval Settings
TOP_K_RESULTS=10
SIMILARITY_THRESHOLD=0.65
MAX_CONTEXT_CHUNKS=5

# Context Shield Thresholds
DUPLICATE_THRESHOLD=0.95
RELEVANCE_THRESHOLD=0.65
CONTRADICTION_THRESHOLD=0.3
FRESHNESS_PENALTY_YEARS=5

# CQS Weights
CQS_WEIGHT_RELEVANCE=0.4
CQS_WEIGHT_CREDIBILITY=0.3
CQS_WEIGHT_CONSISTENCY=0.2
CQS_WEIGHT_FRESHNESS=0.1

# Risk Engine Thresholds
RISK_LOW_THRESHOLD=30
RISK_HIGH_THRESHOLD=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
